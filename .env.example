# Copy to .env to override defaults.
# GPU=0                          # one card: index or UUID
# HOST=127.0.0.1
# PORT=8000
# MODELS_DIR=/path/to/models
# MAX_MODEL_LEN=163840           # default: 262144 on a 64 GB card, 163840 on 40 GB
# HOST_TUNE=1                    # 0 = skip host-tune.sh (numbers may be lower)
# IMAGE=ghcr.io/alexbrandes/cmp170hx-qwen38-27b@sha256:...
